NICHE_ENV=development
NICHE_API_PORT=8100
NICHE_FRONTEND_ORIGIN=http://localhost:5173
NICHE_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/niche
NICHE_JWT_SECRET=change-me
NICHE_JWT_EXPIRES_MINUTES=1440
NICHE_GOOGLE_CLIENT_ID=
NICHE_GOOGLE_CLIENT_SECRET=
NICHE_GITHUB_CLIENT_ID=
NICHE_GITHUB_CLIENT_SECRET=
NICHE_OAUTH_REDIRECT_BASE=http://localhost:8100
NICHE_RATE_LIMIT_PER_MINUTE=120

# Legacy NICHEGPT_* variables are still accepted for backward compatibility.
